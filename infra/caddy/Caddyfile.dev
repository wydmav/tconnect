:80 {
	encode gzip

	handle /healthz {
		reverse_proxy api:3000
	}

	handle /readyz {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /adopt/* {
		reverse_proxy api:3000
	}

	handle /hb/* {
		reverse_proxy api:3000
	}

	handle /cfg/* {
		reverse_proxy api:3000
	}

	handle /webhooks/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy admin:3000
	}
}
